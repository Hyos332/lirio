# mock | shopify
COMMERCE_PROVIDER=mock

# Dominio .myshopify.com de la tienda, sin https://
SHOPIFY_STORE_DOMAIN=
# Token público de la Storefront API (canal "Headless")
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Versión estable de la Storefront API, por ejemplo 2026-10
SHOPIFY_API_VERSION=
# Secreto con el que Shopify firma los webhooks
SHOPIFY_WEBHOOK_SECRET=

# País por defecto (ISO de dos letras)
SHOPIFY_COUNTRY=ES
NEXT_PUBLIC_SITE_URL=http://localhost:3000
